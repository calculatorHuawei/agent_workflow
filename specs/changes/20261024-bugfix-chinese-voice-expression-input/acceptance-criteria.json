  "assumptions": [
    { "id": "ASM-001", "text": "采用 SDK API 12 可用的 @kit.CoreSpeechKit 在线中文识别（language=zh-CN, online=0），以接口隔离服务差异。", "rationale": "Issue 允许设计阶段选择现有 HarmonyOS 能力；不引入凭据或付费第三方。" },
    { "id": "ASM-002", "text": "首期语法严格限制为一个二元四则表达式，允许操作数一元负号。", "rationale": "与非目标一致，并优先避免误算。" },
    { "id": "ASM-003", "text": "常见中文数字支持零/〇、一至九、两、十/百/千/万及逐位数字；小数点后逐位解析；亿、分数、单位量词和省略口语拒绝。", "rationale": "提供可确定验收的最小常见集合，后续可向后兼容扩展。" },
    { "id": "ASM-004", "text": "规范化表达式统一显示 ASCII + - * /。", "rationale": "验收明确要求 123+456，且 CalcEngine 原生使用 ASCII；×/÷ 输入仍被接受。" },
    { "id": "ASM-005", "text": "原始识别文本仅保存在当前页面状态，音频仅在内存流式处理，不持久化或写日志。", "rationale": "最小化权限和数据处理，不做额外隐私产品决策。" },
    { "id": "ASM-006", "text": "权限仅在用户点击入口时申请；拒绝后由用户主动重试。", "rationale": "符合按需授权和避免骚扰的惯例。" },
    { "id": "ASM-007", "text": "设备 UI 注入只存在于可追溯源码 SHA 的测试构建或测试 Ability 中；release 构建始终装配真实 gateway，且不能通过 Want、深链或隐藏点击启用 fake。", "rationale": "满足 Tester 独立 UI 自动化，同时最小化生产权限、攻击面和误发布风险。" },
    { "id": "ASM-008", "text": "真实语音 AC 仅在预检确认麦克风、网络和 zh-CN CoreSpeechKit 服务均可用的环境执行；不以 fake 结果替代 AC-015。", "rationale": "Tester run 114 证明普通模拟器可能在 createEngine 阶段缺能力；能力不足应作为环境限制记录，而非改变产品语义或引入付费服务。" },
    { "id": "ASM-009", "text": "权限时序 AC-016 用真实系统权限框加 test-only scripted gateway 证明授权前 gateway start 为零、授权后页面进入 listening；真实 AudioCapturer/recognizer 成功启动归入 AC-015。", "rationale": "把可确定验证的权限顺序与外部 CoreSpeechKit 可用性解耦，既不降低授权前禁止录音的 oracle，也不让服务缺失掩盖权限缺陷。" }
  ],
  "out_of_scope": [
