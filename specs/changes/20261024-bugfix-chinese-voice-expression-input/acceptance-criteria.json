{
  "version": "1.0",
  "source_requirements": [
    { "id": "IR-001", "text": "普通计算模式提供语音输入入口。" },
    { "id": "IR-002", "text": "单轮语音会话明确展示监听中、识别中、成功和失败状态。" },
    { "id": "IR-003", "text": "首次使用时按 HarmonyOS 规范申请麦克风权限，且授权成功前不得启动语音网关或录音。" },
    { "id": "IR-004", "text": "拒绝麦克风权限后应用不崩溃、不持续录音，并显示可理解的权限说明和重试入口。" },
    { "id": "IR-005", "text": "将中文加、减、乘、除及符号 +、-、×、÷ 映射为现有计算引擎支持的运算符。" },
    { "id": "IR-006", "text": "支持口述阿拉伯数字。" },
    { "id": "IR-007", "text": "支持常见中文整数表达和逐位中文数字表达。" },
    { "id": "IR-008", "text": "支持表达式中的中文口述小数。" },
    { "id": "IR-009", "text": "识别成功后保留可见识别文本，自动填入规范化算式并计算结果。" },
    { "id": "IR-010", "text": "无识别结果时显示明确错误且不覆盖语音前的算式。" },
    { "id": "IR-011", "text": "歧义或非法语法时显示明确错误且不覆盖语音前的算式。" },
    { "id": "IR-012", "text": "语音算式除以零时显示明确错误且不覆盖语音前的算式。" },
    { "id": "IR-013", "text": "语音识别服务不可用时安全停止、显示明确错误且不覆盖语音前的算式。" },
    { "id": "IR-014", "text": "录音中断时安全停止、显示明确错误且不覆盖语音前的算式。" },
    { "id": "IR-015", "text": "监听期间支持取消；取消立即停止本轮输入且不产生计算结果。" },
    { "id": "IR-016", "text": "有效语音计算复用手动输入计算逻辑，并按现有规则恰好写入一条历史记录。" },
    { "id": "IR-017", "text": "Tester 可注入或模拟识别结果，在不依赖真实麦克风或在线服务时独立验证解析与设备 UI 自动化。" },
    { "id": "IR-018", "text": "Tester 在具备麦克风、网络和中文语音服务的真机或等价环境补充真实语音端到端证据。" }
  ],
  "acceptance_criteria": [
    {
      "id": "AC-001", "title": "语音入口与会话状态完整可见", "source_requirement_ids": ["IR-001", "IR-002"], "category": "normal", "level": "feature",
      "given": ["用户位于普通计算模式且语音状态为空闲", "装配真实可用识别服务，或装配受测试构建隔离的确定性设备 fake"],
      "when": ["用户点击麦克风并完成一个可识别算式会话"],
      "then": ["界面先显示监听中，再显示识别中", "最终显示成功状态；每个状态对应的操作控件同步更新"],
      "observable": { "type": "ui_state", "target": "麦克风入口、语音状态文本和取消/重试控件" },
      "verification_layers": ["integration", "ui", "e2e"],
      "oracle": { "type": "ordered_states", "expected": ["listening", "recognizing", "success"] },
      "environment": { "device_required": true, "capabilities": ["HarmonyOS UI", "CoreSpeechKit or test-only device fake"] }, "priority": "P0"
    },
    {
      "id": "AC-002", "title": "麦克风权限拒绝和重试", "source_requirement_ids": ["IR-003", "IR-004"], "category": "recovery", "level": "feature",
      "given": ["应用尚未获得麦克风权限", "当前表达式为 12+3"],
      "when": ["用户点击麦克风并在系统权限框选择拒绝，随后点击界面重试入口"],
      "then": ["拒绝后不进入监听且显示权限用途说明和重试入口", "表达式仍为 12+3；重试只重新发起授权流程，不后台持续请求或录音"],
      "observable": { "type": "ui_state", "target": "权限说明、重试入口、语音状态和表达式" },
      "verification_layers": ["integration", "ui", "e2e"],
      "oracle": { "type": "state_predicate", "expected": { "state": "permissionDenied", "expression": "12+3", "recording": false, "retryVisible": true } },
      "environment": { "device_required": true, "capabilities": ["HarmonyOS permission dialog", "microphone permission"] }, "priority": "P0"
    },
    {
      "id": "AC-003", "title": "八种运算词符号规范化", "source_requirement_ids": ["IR-005"], "category": "normal", "level": "feature",
      "given": ["可注入识别结果已启用", "每次会话输入两个有效数值"],
      "when": ["分别注入 加、减、乘、除、+、-、×、÷ 作为二元运算符"],
      "then": ["界面分别显示使用 +、-、*、/ 的等价规范化表达式", "每个表达式均由既有计算引擎得到对应结果"],
      "observable": { "type": "ui_text", "target": "规范化表达式和计算结果" },
      "verification_layers": ["unit", "integration", "ui"],
      "oracle": { "type": "exact_table", "expected": { "1加2": "1+2", "3减2": "3-2", "2乘3": "2*3", "8除4": "8/4", "1+2": "1+2", "3-2": "3-2", "2×3": "2*3", "8÷4": "8/4" } },
      "environment": { "device_required": false, "capabilities": ["injected recognition result"] }, "priority": "P0"
    },
    {
      "id": "AC-004", "title": "阿拉伯与中文整数计算", "source_requirement_ids": ["IR-006", "IR-007"], "category": "normal", "level": "feature",
      "given": ["语音解析器处于空闲且使用严格二元四则语法"],
      "when": ["依次注入 123加456、二十乘三、一百零二减两"],
      "then": ["规范化表达式依次为 123+456、20*3、102-2", "结果依次为 579、60、100"],
      "observable": { "type": "ui_text", "target": "识别文本、规范化表达式和结果" },
      "verification_layers": ["unit", "integration", "ui"],
      "oracle": { "type": "exact_table", "expected": { "123加456": ["123+456", "579"], "二十乘三": ["20*3", "60"], "一百零二减两": ["102-2", "100"] } },
      "environment": { "device_required": false, "capabilities": ["injected recognition result"] }, "priority": "P0"
    },
    {
      "id": "AC-005", "title": "中文小数计算", "source_requirement_ids": ["IR-008"], "category": "boundary", "level": "feature",
      "given": ["可注入识别结果已启用"],
      "when": ["注入 十点五减二点五"],
      "then": ["规范化表达式显示 10.5-2.5", "结果显示 8"],
      "observable": { "type": "ui_text", "target": "规范化小数表达式和结果" },
      "verification_layers": ["unit", "integration", "ui"],
      "oracle": { "type": "exact", "expected": { "expression": "10.5-2.5", "result": "8" } },
      "environment": { "device_required": false, "capabilities": ["injected recognition result"] }, "priority": "P0"
    },
    {
      "id": "AC-006", "title": "歧义或非法语法拒绝", "source_requirement_ids": ["IR-011"], "category": "exception", "level": "feature",
      "given": ["语音开始前表达式为 7*8", "历史记录数量为 N"],
      "when": ["分别注入缺操作数、多运算链、未知词或多小数点的文本"],
      "then": ["每次显示 无法理解该算式 或等价明确错误", "表达式保持 7*8、结果不被新值覆盖且历史仍为 N"],
      "observable": { "type": "ui_state", "target": "错误文本、表达式、结果和历史列表" },
      "verification_layers": ["unit", "integration", "ui"],
      "oracle": { "type": "invariant", "expected": { "expression": "7*8", "historyDelta": 0, "state": "error" } },
      "environment": { "device_required": false, "capabilities": ["injected recognition result"] }, "priority": "P0"
    },
    {
      "id": "AC-007", "title": "有效识别展示并自动计算", "source_requirement_ids": ["IR-009", "IR-016"], "category": "normal", "level": "feature",
      "given": ["用户位于普通计算模式", "可注入识别结果已启用"],
      "when": ["注入最终识别文本 123加456"],
      "then": ["可见识别文本为 123加456", "表达式显示 123+456、结果显示 579，并使用现有数字格式规则"],
      "observable": { "type": "ui_text", "target": "原始识别文本、表达式和结果" },
      "verification_layers": ["integration", "ui"],
      "oracle": { "type": "exact", "expected": { "recognizedText": "123加456", "expression": "123+456", "result": "579" } },
      "environment": { "device_required": false, "capabilities": ["injected recognition result", "HarmonyOS UI"] }, "priority": "P0"
    },
    {
      "id": "AC-008", "title": "无识别结果保留旧输入", "source_requirement_ids": ["IR-010"], "category": "exception", "level": "feature",
      "given": ["语音前表达式为 42-1", "历史记录数量为 N"],
      "when": ["识别网关完成但返回空字符串或仅空白"],
      "then": ["显示 未识别到内容 或等价明确错误", "表达式仍为 42-1且历史仍为 N"],
      "observable": { "type": "ui_state", "target": "语音错误、表达式和历史" },
      "verification_layers": ["integration", "ui"],
      "oracle": { "type": "invariant", "expected": { "expression": "42-1", "historyDelta": 0, "state": "error" } },
      "environment": { "device_required": false, "capabilities": ["fake recognition gateway"] }, "priority": "P0"
    },
    {
      "id": "AC-009", "title": "语音除零安全失败", "source_requirement_ids": ["IR-012", "IR-016"], "category": "exception", "level": "feature",
      "given": ["语音前表达式为 9+9，结果为 18", "历史记录数量为 N"],
      "when": ["注入最终识别文本 十除零"],
      "then": ["显示 除数不能为零", "表达式仍为 9+9、结果仍为 18且历史仍为 N"],
      "observable": { "type": "ui_state", "target": "计算错误、原表达式、原结果和历史" },
      "verification_layers": ["integration", "ui"],
      "oracle": { "type": "exact_invariant", "expected": { "error": "除数不能为零", "expression": "9+9", "result": "18", "historyDelta": 0 } },
      "environment": { "device_required": false, "capabilities": ["injected recognition result"] }, "priority": "P0"
    },
    {
      "id": "AC-010", "title": "识别服务不可用可恢复", "source_requirement_ids": ["IR-013"], "category": "recovery", "level": "feature",
      "given": ["语音前表达式为 5+5", "权限已授予"],
      "when": ["识别引擎创建或启动返回服务不可用或 busy 错误"],
      "then": ["显示 语音服务不可用 或等价明确错误及重试入口", "录音停止、表达式保持 5+5且手动计算仍可使用"],
      "observable": { "type": "ui_state", "target": "服务错误、重试入口、录音状态和表达式" },
      "verification_layers": ["integration", "ui", "e2e"],
      "oracle": { "type": "state_predicate", "expected": { "state": "error", "expression": "5+5", "recording": false, "manualInputEnabled": true } },
      "environment": { "device_required": false, "capabilities": ["fake service error"], "real_device_optional": true }, "priority": "P0"
    },
    {
      "id": "AC-011", "title": "录音中断清理并保留输入", "source_requirement_ids": ["IR-014"], "category": "recovery", "level": "feature",
      "given": ["界面处于监听中且原表达式为 6*7"],
      "when": ["AudioCapturer 或语音网关报告录音中断"],
      "then": ["显示 录音已中断 或等价明确错误", "本轮资源被停止释放，表达式仍为 6*7且不写历史"],
      "observable": { "type": "ui_state", "target": "中断错误、会话状态、表达式和历史" },
      "verification_layers": ["integration", "ui", "e2e"],
      "oracle": { "type": "invariant", "expected": { "state": "error", "expression": "6*7", "recording": false, "historyDelta": 0 } },
      "environment": { "device_required": false, "capabilities": ["fake recording interruption"], "real_device_optional": true }, "priority": "P0"
    },
    {
      "id": "AC-012", "title": "监听取消立即且无结果", "source_requirement_ids": ["IR-002", "IR-015"], "category": "exception", "level": "feature",
      "given": ["语音前表达式为 2+2且当前处于监听中", "历史记录数量为 N"],
      "when": ["用户点击取消，随后测试网关发送该旧 session 的最终结果"],
      "then": ["界面立即离开监听/识别状态且录音停止", "迟到结果被忽略，表达式仍为 2+2且历史仍为 N"],
      "observable": { "type": "ui_state", "target": "语音状态、录音状态、表达式、结果和历史" },
      "verification_layers": ["integration", "ui", "e2e"],
      "oracle": { "type": "state_predicate", "expected": { "state": "idle", "recording": false, "expression": "2+2", "historyDelta": 0, "lateResultIgnored": true } },
      "environment": { "device_required": false, "capabilities": ["fake delayed callback"], "real_device_optional": true }, "priority": "P0"
    },
    {
      "id": "AC-013", "title": "语音历史恰好写入一次", "source_requirement_ids": ["IR-016"], "category": "boundary", "level": "feature",
      "given": ["历史记录数量为 N", "网关可发送局部结果和重复最终回调"],
      "when": ["同一 session 依次发送局部文本、最终文本 123加456、重复最终文本"],
      "then": ["最终结果为 579", "历史记录数量恰为 N+1，新增条目表达式 123+456、结果 579"],
      "observable": { "type": "data_state", "target": "页面历史列表与 Preferences 历史" },
      "verification_layers": ["integration", "ui"],
      "oracle": { "type": "exact_delta", "expected": { "historyDelta": 1, "expression": "123+456", "result": "579" } },
      "environment": { "device_required": false, "capabilities": ["fake partial and duplicate callbacks", "Preferences test double"] }, "priority": "P0"
    },
    {
      "id": "AC-014", "title": "解析与控制器可脱离麦克风验证", "source_requirement_ids": ["IR-017"], "category": "compatibility", "level": "feature",
      "given": ["本地或 CI 测试环境没有麦克风或在线语音服务", "测试代码装配可控的 fake recognition gateway"],
      "when": ["Tester 注入成功、空结果、歧义、服务错误、录音中断和迟到回调"],
      "then": ["所有解析 oracle 和控制器状态/恢复行为均可自动断言", "测试结果不因真实麦克风缺失而跳过或伪装成功"],
      "observable": { "type": "system_state", "target": "本地自动化结果与 fake gateway 事件记录" },
      "verification_layers": ["unit", "integration"],
      "oracle": { "type": "test_matrix", "expected": { "deterministicCases": true, "microphoneRequired": false, "coveredOutcomes": ["success", "empty", "ambiguous", "serviceError", "interrupted", "cancelLateCallback"] } },
      "environment": { "device_required": false, "capabilities": ["dependency injection", "fake recognition gateway"] }, "priority": "P0"
    },
    {
      "id": "AC-015", "title": "真实设备语音链路证据", "source_requirement_ids": ["IR-018"], "category": "normal", "level": "feature",
      "given": ["具备麦克风、网络、中文 CoreSpeechKit 服务和授权能力的 HarmonyOS 真机或等价模拟环境"],
      "when": ["Tester 点击麦克风并说 123加456"],
      "then": ["证据记录权限/监听/识别/成功链路", "界面显示识别文本、123+456 和 579；若环境缺能力则明确记为环境限制而不替代注入测试"],
      "observable": { "type": "artifact_semantics", "target": "真机 UI 录屏/截图与结构化测试记录" },
      "verification_layers": ["e2e"],
      "oracle": { "type": "semantic_evidence", "expected": { "expression": "123+456", "result": "579", "statesObserved": ["listening", "recognizing", "success"] } },
      "environment": { "device_required": true, "capabilities": ["microphone", "network", "CoreSpeechKit zh-CN"] }, "priority": "P1"
    },
    {
      "id": "AC-016", "title": "授权成功后才启动语音网关", "source_requirement_ids": ["IR-003"], "category": "normal", "level": "feature",
      "given": ["麦克风权限处于未决定状态", "设备测试装配记录页面权限结果、gateway start 调用和 scripted listening 事件，且仍走真实 HarmonyOS 权限框"],
      "when": ["用户点击麦克风并允许权限"],
      "then": ["授权结果为允许后才创建 gateway 并调用 start；授权结果返回前 gatewayStartCount 为 0", "scripted gateway 随后发出 listening，界面显示监听中；真实 AudioCapturer/recognizer 成功启动只由 AC-015 在能力可用环境证明"],
      "observable": { "type": "system_state", "target": "真实权限框、授权结果、gateway 启动计数/事件和监听 UI" },
      "verification_layers": ["integration", "ui", "e2e"],
      "oracle": { "type": "event_order", "expected": { "beforeGrant": { "gatewayStartCount": 0 }, "orderedEvents": ["permissionGranted", "gatewayStartInvoked", "scriptedListening", "uiListening"] } },
      "environment": { "device_required": true, "capabilities": ["HarmonyOS permission dialog", "device-installable test assembly"] }, "priority": "P0"
    },
    {
      "id": "AC-017", "title": "重复点击不创建并发会话", "source_requirement_ids": ["IR-002", "IR-015"], "category": "boundary", "level": "feature",
      "given": ["一个语音 session 已处于监听中"],
      "when": ["用户快速重复点击麦克风入口"],
      "then": ["系统最多保留一个活动 session 和一个 AudioCapturer", "界面状态不抖回空闲且不会产生重复计算/历史"],
      "observable": { "type": "system_state", "target": "活动 session、录音实例、UI 状态和历史" },
      "verification_layers": ["integration", "ui"],
      "oracle": { "type": "cardinality", "expected": { "activeSessions": 1, "activeCapturers": 1, "historyDeltaBeforeFinal": 0 } },
      "environment": { "device_required": false, "capabilities": ["fake recognition gateway", "rapid UI events"] }, "priority": "P1"
    },
    {
      "id": "AC-018", "title": "逐位中文数字、负数与小数边界", "source_requirement_ids": ["IR-007", "IR-008"], "category": "boundary", "level": "feature",
      "given": ["解析器采用首期明确数字语法"],
      "when": ["分别注入 二〇二四减二千、负二加五、零点零五加一点九五"],
      "then": ["分别规范化为 2024-2000、-2+5、0.05+1.95", "结果分别为 24、3、2"],
      "observable": { "type": "ui_text", "target": "边界数字的规范化表达式和结果" },
      "verification_layers": ["unit", "integration", "ui"],
      "oracle": { "type": "exact_table", "expected": { "二〇二四减二千": ["2024-2000", "24"], "负二加五": ["-2+5", "3"], "零点零五加一点九五": ["0.05+1.95", "2"] } },
      "environment": { "device_required": false, "capabilities": ["injected recognition result"] }, "priority": "P1"
    },
    {
      "id": "AC-019", "title": "设备可见的确定性 UI 注入矩阵", "source_requirement_ids": ["IR-017"], "category": "normal", "level": "feature",
      "given": ["Tester 安装与目标源码 SHA 一致的设备测试构建", "测试构建以编译期或测试 Ability 隔离方式装配 scripted gateway，release 构建无法激活该路径"],
      "when": ["Tester 通过测试 harness 依次触发成功、空结果、歧义、除零、服务错误、录音中断、取消迟到回调、重复点击和重复 final 场景"],
      "then": ["每个场景均能从设备 UI 树、截图和结构化事件中观察同一份 acceptance-criteria oracle", "成功场景显示原文、规范式、结果和一次历史；失败或取消场景保留旧输入与历史", "release 构建不暴露测试场景选择、任意文本注入或 fake gateway 激活入口"],
      "observable": { "type": "artifact_semantics", "target": "设备 UI 树、截图、页面/Preferences 状态差异和测试 harness 事件记录" },
