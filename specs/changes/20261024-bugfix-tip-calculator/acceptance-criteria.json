      "when": ["用户进入小费面板完成一次分摊并返回，再打开历史、切换普通/科学并进入绘图"],
      "then": ["表达式和结果与进入前一致", "历史条目数量和内容完全一致且没有小费记录", "现有普通/科学/绘图交互仍可用", "若交付基线含程序员模式，其入口和状态同样不得改变"],
      "observable": { "type": "ui_state", "target": "主显示屏、历史列表、模式切换和绘图面板" },
      "verification_layers": ["integration", "ui", "e2e"],
      "oracle": { "type": "before_after_equality", "expected": { "expression": "2+3", "result": "5", "historyDelta": 0, "tipHistoryItems": 0, "existingModesUsable": true } },
      "environment": { "device_required": true, "capabilities": ["HarmonyOS ArkUI", "Preferences history"] },
      "priority": "P0"
    },
