  "assumptions": [
    { "id": "A-001", "decision": "Issue 产品意图按新增功能解释，但目录沿用编排器 change_type=bugfix。", "rationale": "保留任务路由元数据，同时不扭曲产品需求语义。" },
    { "id": "A-002", "decision": "采用既有 CalculatorPage Stack 覆盖面板，不新增路由页。", "rationale": "仓内 PlotPanel/SettingsPanel 已采用此惯例，变更可逆且状态隔离风险最低。" },
    { "id": "A-003", "decision": "初始比例为 15%、人数为 1、账单为空；首次进入不显示错误，字段被清空后显示错误。", "rationale": "常见默认值并避免初始页面噪声，同时满足空值校验。" },
    { "id": "A-004", "decision": "金额与自定义比例使用点号十进制且最多两位小数；金额允许 0。", "rationale": "保证货币计算可确定且不引入 locale/币种范围。" },
    { "id": "A-005", "decision": "小费先四舍五入到分，总额等于账单分值加小费分值，每人金额再四舍五入到分。", "rationale": "保证显示的小费与总额可加和，并给出唯一 oracle。" },
    { "id": "A-006", "decision": "任一字段无效时所有结果显示 --，修正后即时恢复。", "rationale": "避免混合新旧值造成误导。" },
    { "id": "A-007", "decision": "小费表单仅在当前页面生命周期内保留，不写 Preferences 或历史。", "rationale": "最小数据范围并保护现有历史语义。" },
    { "id": "A-008", "decision": "结果不显示货币符号。", "rationale": "Issue 未指定币种，擅加币种会造成错误语义。" }
  ],
  "out_of_scope": [
    "支付、收款、扫码或账单识别",
    "按个人消费项目进行不等额分摊",
    "税费、币种换算和多币种格式",
    "小费表单跨启动持久化或写入普通计算历史",
    "补建当前代码仓不存在的程序员模式",
    "新增网络、权限、付费服务或第三方依赖"
  ]
}
