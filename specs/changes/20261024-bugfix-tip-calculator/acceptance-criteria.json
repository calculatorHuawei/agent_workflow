      "observable": { "type": "ui_text", "target": "三项金额格式及循环小数分摊结果" },
      "verification_layers": ["unit", "integration", "ui"],
      "oracle": { "type": "exact", "expected": { "tip": "1.00", "total": "11.00", "perPerson": "3.67", "fractionDigits": 2 } },
      "environment": { "device_required": true, "capabilities": ["HarmonyOS ArkUI"] },
      "priority": "P0"
