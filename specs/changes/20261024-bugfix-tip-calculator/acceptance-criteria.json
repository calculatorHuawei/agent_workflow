{
  "version": "1.0",
  "source_requirements": [
    { "id": "IR-001", "text": "新增小费计算器入口，且不影响普通、科学、绘图和程序员模式。" },
    { "id": "IR-002", "text": "输入账单金额和人数，支持选择 0%/10%/15%/20% 以及 0%–100% 的自定义小费比例。" },
    { "id": "IR-003", "text": "输入变化后无需额外点击，自动同步计算小费金额、含小费总额和每人应付金额。" },
    { "id": "IR-004", "text": "金额统一显示两位小数，每人金额按货币精度四舍五入。" },
    { "id": "IR-005", "text": "空值、非数字、负金额、人数小于 1 或非整数、比例越界时给出明确提示，不崩溃且不显示误导结果。" },
    { "id": "IR-006", "text": "进入和离开小费计算器后，现有计算器功能和历史记录不受影响。" },
    { "id": "IR-007", "text": "Tester 独立生成并执行核心计算、边界输入和关键 UI 交互测试，保存可追溯证据。" }
  ],
  "acceptance_criteria": [
    {
      "id": "AC-001",
      "title": "横竖屏入口与可逆退出",
      "source_requirement_ids": ["IR-001", "IR-006"],
      "category": "normal",
      "level": "feature",
      "given": ["OpenCalc 主计算器已显示", "设备分别处于竖屏和横屏"],
      "when": ["用户点击可见的“小费”入口，再点击“返回”"],
      "then": ["小费计算面板在两种方向均可到达", "返回后重新显示原主计算器且没有新增路由页面"],
      "observable": { "type": "ui_state", "target": "小费入口、TipPanel 标题和返回后的 CalculatorPage" },
      "verification_layers": ["ui", "e2e"],
      "oracle": { "type": "state_transition", "expected": { "portraitReachable": true, "landscapeReachable": true, "panelTitle": "小费计算器", "returnedToCalculator": true } },
      "environment": { "device_required": true, "capabilities": ["HarmonyOS ArkUI", "orientation change"] },
      "priority": "P0"
    },
    {
      "id": "AC-002",
      "title": "100 元按 15% 两人分摊",
      "source_requirement_ids": ["IR-002", "IR-003", "IR-004"],
      "category": "normal",
      "level": "feature",
      "given": ["用户已进入小费计算器", "输入状态有效"],
      "when": ["用户输入账单金额 100，选择 15%，输入人数 2"],
      "then": ["小费显示 15.00", "总额显示 115.00", "每人应付显示 57.50"],
      "observable": { "type": "ui_text", "target": "小费、总额和每人应付结果区域" },
      "verification_layers": ["unit", "integration", "ui"],
      "oracle": { "type": "exact", "expected": { "tip": "15.00", "total": "115.00", "perPerson": "57.50" } },
      "environment": { "device_required": true, "capabilities": ["HarmonyOS ArkUI"] },
      "priority": "P0"
    },
    {
      "id": "AC-003",
      "title": "88.80 元按 10% 三人分摊",
      "source_requirement_ids": ["IR-002", "IR-003", "IR-004"],
      "category": "normal",
      "level": "feature",
      "given": ["用户已进入小费计算器"],
      "when": ["用户输入账单金额 88.80，选择 10%，输入人数 3"],
