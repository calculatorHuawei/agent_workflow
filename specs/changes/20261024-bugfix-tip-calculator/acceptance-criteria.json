      "source_requirement_ids": ["IR-002", "IR-003", "IR-004"],
      "category": "normal",
      "level": "feature",
      "given": ["当前账单为 100、比例 10%、人数 2，结果为 10.00/110.00/55.00"],
      "when": ["用户依次把金额改为 200、比例改为 20%、人数改为 4，不点击额外计算按钮"],
