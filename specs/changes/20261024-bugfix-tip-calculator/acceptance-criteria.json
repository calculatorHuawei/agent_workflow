      "observable": { "type": "ui_state", "target": "输入框、比例选中态及三项派生结果" },
      "verification_layers": ["integration", "ui", "e2e"],
      "oracle": { "type": "ordered_exact_states", "expected": ["20.00|220.00|110.00", "40.00|240.00|120.00", "40.00|240.00|60.00", "custom:12.5|25.00|225.00|56.25"] },
      "environment": { "device_required": true, "capabilities": ["HarmonyOS ArkUI reactive state"] },
      "priority": "P0"
