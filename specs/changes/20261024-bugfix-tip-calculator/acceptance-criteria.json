{
  "version": "1.0",
  "source_requirements": [
    {"id":"IR-001","text":"提供可见的小费计算器入口，并允许用户返回主计算器。"},
    {"id":"IR-002","text":"用户可输入账单金额和人数。"},
    {"id":"IR-003","text":"用户可选择 0%、10%、15%、20% 预设比例，或输入 0%–100% 自定义比例。"},
    {"id":"IR-004","text":"任一输入变化后，无需额外点击即可同步显示小费、含小费总额和每人应付金额。"},
    {"id":"IR-005","text":"100、15%、2 的结果必须为 15.00、115.00、57.50。"},
    {"id":"IR-006","text":"88.80、10%、3 的总额和每人应付必须为 97.68、32.56。"},
    {"id":"IR-007","text":"0% 小费时按原账单正确分摊。"},
    {"id":"IR-008","text":"金额统一显示两位小数，每人金额按货币精度四舍五入。"},
    {"id":"IR-009","text":"空值、非数字或负账单金额被拒绝并显示明确提示。"},
    {"id":"IR-010","text":"人数为空、小于 1、为负数、小数或非数字时不执行除法并显示明确提示。"},
    {"id":"IR-011","text":"超出 0%–100% 的自定义比例被拒绝；任何非法输入不得崩溃或保留误导结果，修正后应恢复计算。"},
    {"id":"IR-012","text":"进入和离开小费计算器后，普通、科学、绘图、程序员模式（若基线提供）及历史记录不受影响。"},
    {"id":"IR-013","text":"Tester 独立生成并执行核心计算、边界输入和关键 UI 交互测试，保存可追溯证据。"},
    {"id":"IR-014","text":"针对 Tester 设备反馈，可见输入必须是计算使用的同一响应式源；有效的 100、15%、2 不得与结果占位符 -- 同时出现。"}
  ],
  "acceptance_criteria": [
    {
      "id":"AC-001","title":"横竖屏入口与可逆退出","source_requirement_ids":["IR-001","IR-012"],"category":"normal","level":"feature",
      "given":["OpenCalc 主计算器已显示","设备分别处于竖屏和横屏"],"when":["用户点击小费入口，再点击返回"],
      "then":["两种方向均显示小费计算器","返回后原主计算器状态仍可见"],
      "observable":{"type":"ui_state","target":"小费入口、面板标题和返回后的主计算器"},"verification_layers":["ui","e2e"],
      "oracle":{"type":"state_transition","expected":{"portraitReachable":true,"landscapeReachable":true,"panelTitle":"小费计算器","returned":true}},
      "environment":{"device_required":true,"capabilities":["HarmonyOS ArkUI","orientation change"]},"priority":"P0"
    },
    {
      "id":"AC-002","title":"100 元按 15% 两人分摊且可见值与快照一致","source_requirement_ids":["IR-002","IR-003","IR-004","IR-005","IR-008","IR-014"],"category":"normal","level":"feature",
      "given":["用户已进入小费计算器"],"when":["用户通过系统键盘输入账单 100 和人数 2，并点击 15%"],
      "then":["可见输入为 100、15%、2","小费、总额、每人应付立即显示 15.00、115.00、57.50"],
      "observable":{"type":"ui_state","target":"三个可见输入、比例选中态和三个结果"},"verification_layers":["unit","integration","ui","e2e"],
      "oracle":{"type":"exact","expected":{"bill":"100","selectedPercent":"15%","people":"2","tip":"15.00","total":"115.00","perPerson":"57.50"}},
      "environment":{"device_required":true,"capabilities":["HarmonyOS ArkUI","system IME"]},"priority":"P0"
    },
    {
      "id":"AC-003","title":"88.80 元按 10% 三人分摊","source_requirement_ids":["IR-002","IR-003","IR-004","IR-006","IR-008"],"category":"normal","level":"feature",
      "given":["用户已进入小费计算器"],"when":["用户输入账单 88.80、选择 10%、输入人数 3"],
      "then":["小费显示 8.88","总额显示 97.68","每人应付显示 32.56"],
      "observable":{"type":"ui_text","target":"三项金额结果"},"verification_layers":["unit","integration","ui"],
      "oracle":{"type":"exact","expected":{"tip":"8.88","total":"97.68","perPerson":"32.56"}},"environment":{"device_required":true,"capabilities":["HarmonyOS ArkUI"]},"priority":"P0"
    },
    {
      "id":"AC-004","title":"预设、自定义与即时状态同步","source_requirement_ids":["IR-002","IR-003","IR-004","IR-014"],"category":"boundary","level":"feature",
      "given":["当前可见输入为 100、10%、2，结果为 10.00、110.00、55.00"],
      "when":["用户依次把金额改为 200、点击 20%、人数改为 4、输入自定义 12.5，期间不点击计算按钮"],
      "then":["四次编辑后结果依次为 20.00/220.00/110.00、40.00/240.00/120.00、40.00/240.00/60.00、25.00/225.00/56.25","每次可见输入和同帧结果对应且预设/自定义互斥选中"],
      "observable":{"type":"ui_state","target":"输入框、四个独立预设、自定义选中态及有序结果"},"verification_layers":["integration","ui","e2e"],
      "oracle":{"type":"ordered_exact_states","expected":["200|10%|2=>20.00|220.00|110.00","200|20%|2=>40.00|240.00|120.00","200|20%|4=>40.00|240.00|60.00","200|custom:12.5|4=>25.00|225.00|56.25"]},
      "environment":{"device_required":true,"capabilities":["HarmonyOS ArkUI reactive state","system IME"]},"priority":"P0"
    },
    {
      "id":"AC-005","title":"零小费和货币舍入边界","source_requirement_ids":["IR-004","IR-007","IR-008"],"category":"boundary","level":"feature",
      "given":["用户已进入小费计算器"],"when":["用户先输入 100、0%、3，再输入 10、10%、3"],
      "then":["第一组显示 0.00、100.00、33.33","第二组显示 1.00、11.00、3.67","所有金额均含两位小数"],
      "observable":{"type":"ui_text","target":"0% 选中态和三项金额格式"},"verification_layers":["unit","integration","ui"],
      "oracle":{"type":"ordered_exact_states","expected":["0.00|100.00|33.33","1.00|11.00|3.67"]},"environment":{"device_required":true,"capabilities":["HarmonyOS ArkUI"]},"priority":"P0"
    },
    {
      "id":"AC-006","title":"非法账单被拒绝并可恢复","source_requirement_ids":["IR-002","IR-009","IR-011"],"category":"exception","level":"feature",
      "given":["界面已有一组有效结果"],"when":["用户依次输入空值、abc、-1、超过安全范围的数，再改回 100"],
      "then":["每个非法值显示可理解的账单错误且三项结果均为 --","改回 100 后错误消失并恢复结果"],
      "observable":{"type":"ui_state","target":"账单错误和结果清空/恢复"},"verification_layers":["unit","integration","ui"],
      "oracle":{"type":"predicate","expected":{"invalid":"billErrorVisible && allResults==='--'","recovered":"billErrorHidden && resultsRecomputed"}},"environment":{"device_required":true,"capabilities":["HarmonyOS ArkUI"]},"priority":"P0"
    },
    {
      "id":"AC-007","title":"非法人数在除法前被拒绝并可恢复","source_requirement_ids":["IR-002","IR-010","IR-011"],"category":"exception","level":"feature",
      "given":["账单和比例有效且界面已有结果"],"when":["用户依次输入空值、0、-1、1.5、abc，再改回 2"],
      "then":["每个非法值显示人数必须为不小于 1 的整数且三项结果均为 --","不显示 Infinity 或 NaN","改回 2 后恢复结果"],
      "observable":{"type":"ui_state","target":"人数错误和结果区域"},"verification_layers":["unit","integration","ui"],
      "oracle":{"type":"predicate","expected":{"invalid":"peopleErrorVisible && allResults==='--' && noInfinityOrNaN","recovered":"peopleErrorHidden && resultsRecomputed"}},"environment":{"device_required":true,"capabilities":["HarmonyOS ArkUI"]},"priority":"P0"
    },
    {
      "id":"AC-008","title":"自定义比例边界、拒绝和预设恢复","source_requirement_ids":["IR-003","IR-011"],"category":"recovery","level":"feature",
      "given":["账单为 100、人数为 2"],"when":["用户输入自定义 0、100、-0.01、100.01、abc、空值，再点击预设 15%"],
      "then":["0 和 100 可计算且自定义态选中","其余值显示比例错误并清空结果","点击 15% 后恢复 15.00、115.00、57.50"],
      "observable":{"type":"ui_state","target":"自定义输入、选中态、错误和结果"},"verification_layers":["unit","integration","ui"],
      "oracle":{"type":"predicate","expected":{"boundaries":"0=>0.00|100=>100.00","invalid":"percentErrorVisible && allResults==='--'","recovery":"15%|15.00|115.00|57.50"}},"environment":{"device_required":true,"capabilities":["HarmonyOS ArkUI"]},"priority":"P0"
    },
    {
      "id":"AC-009","title":"主计算器、模式和历史零污染","source_requirement_ids":["IR-012"],"category":"compatibility","level":"feature",
      "given":["主计算器已有表达式、结果和历史，科学与绘图模式可达"],"when":["用户进入小费计算器完成分摊并返回，再查看既有模式和历史"],
      "then":["原表达式、结果和历史逐项相等","小费计算不新增历史","普通、科学、绘图及基线存在的程序员模式仍可用"],
      "observable":{"type":"ui_state","target":"进出前后的主状态、模式入口和历史集合"},"verification_layers":["integration","ui","e2e"],
      "oracle":{"type":"state_equality","expected":{"expression":"unchanged","result":"unchanged","history":"sameItemsAndCount","existingModes":"reachable"}},"environment":{"device_required":true,"capabilities":["HarmonyOS ArkUI","existing calculator modes"]},"priority":"P0"
    },
    {
      "id":"AC-010","title":"独立 Tester 证据可追溯","source_requirement_ids":["IR-013"],"category":"normal","level":"feature",
      "given":["候选构建绑定唯一提交 SHA"],"when":["Tester 独立执行核心、边界、恢复、横竖屏、状态同步和兼容性测试"],
      "then":["每条 AC 记录通过或失败及证据路径","证据包含环境、命令状态、截图或 UI 树和构建 SHA","未执行项不得标记通过"],
      "observable":{"type":"artifact_semantics","target":"Tester 报告和证据清单"},"verification_layers":["integration","ui","e2e"],
      "oracle":{"type":"schema_and_traceability","expected":{"allAcIdsRecorded":true,"revisionBound":true,"evidencePathsExist":true,"unexecutedNotPassed":true}},"environment":{"device_required":true,"capabilities":["HarmonyOS device or emulator","evidence storage"]},"priority":"P0"
    },
    {
      "id":"AC-011","title":"Tester P0 回归：真实键盘输入与结果原子一致","source_requirement_ids":["IR-004","IR-011","IR-014"],"category":"recovery","level":"feature",
      "given":["安装修复后的 exact-head HAP","面板刚打开且结果为 --"],"when":["Tester 用真实系统键盘输入 100 和 2、点击 15%，随后把账单改为 101"],
      "then":["先显示 15.00、115.00、57.50 而非 --","再显示 15.15、116.15、58.08","UI 树可见输入和同帧结果匹配"],
      "observable":{"type":"ui_state","target":"真机 TextInput 值、预设选中态和同帧结果"},"verification_layers":["integration","ui","e2e"],
      "oracle":{"type":"ordered_exact_states","expected":["100|15%|2=>15.00|115.00|57.50","101|15%|2=>15.15|116.15|58.08"]},"environment":{"device_required":true,"capabilities":["HarmonyOS real device","system IME","UI tree dump"]},"priority":"P0"
    }
