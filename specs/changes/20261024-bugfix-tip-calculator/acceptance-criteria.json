    {
      "id": "AC-007",
      "title": "非法账单金额被拒绝且可恢复",
      "source_requirement_ids": ["IR-005"],
      "category": "exception",
      "level": "feature",
      "given": ["用户已获得一组有效结果"],
      "when": ["用户依次将账单金额改为空值、abc、-1 和超过安全计算范围的数，再改回 100"],
      "then": ["每个非法值均显示可理解的金额错误", "非法期间三项结果均显示 -- 而不是旧值", "改回 100 后错误消失并自动恢复正确结果"],
      "observable": { "type": "ui_state", "target": "金额错误文本与结果区域的清空/恢复" },
      "verification_layers": ["unit", "integration", "ui"],
      "oracle": { "type": "predicate", "expected": { "invalidStates": "amountErrorVisible && allResults==='--'", "recovered": "amountErrorHidden && resultsRecomputed" } },
      "environment": { "device_required": true, "capabilities": ["HarmonyOS ArkUI"] },
      "priority": "P0"
    },
    {
      "id": "AC-008",
      "title": "非法人数不执行除法且可恢复",
      "source_requirement_ids": ["IR-005"],
      "category": "exception",
      "level": "feature",
      "given": ["账单和比例有效"],
      "when": ["用户依次输入人数空值、0、-1、1.5 和 abc，再输入 2"],
      "then": ["每个非法人数均显示“人数必须为不小于 1 的整数”或等义提示", "非法期间不执行除法且三项结果显示 --", "输入 2 后提示消失并自动恢复结果"],
      "observable": { "type": "ui_state", "target": "人数错误文本与结果区域" },
      "verification_layers": ["unit", "integration", "ui"],
      "oracle": { "type": "predicate", "expected": { "rejected": ["", "0", "-1", "1.5", "abc"], "divisionWhileInvalid": false, "validRecovery": "2" } },
      "environment": { "device_required": true, "capabilities": ["HarmonyOS ArkUI"] },
      "priority": "P0"
    },
    {
      "id": "AC-009",
      "title": "自定义比例边界、互斥选中与恢复",
      "source_requirement_ids": ["IR-002", "IR-005"],
      "category": "boundary",
      "level": "feature",
      "given": ["账单为 100、人数为 2"],
      "when": ["用户选择自定义并依次输入 0、100、-0.01、100.01、abc、空值，然后点击预设 15%"],
      "then": ["0 和 100 被接受并分别得到 0.00/100.00/50.00 与 100.00/200.00/100.00", "其余自定义值显示 0%–100% 的明确提示且结果为 --", "点击 15% 后仅 15% 为选中态、错误清除且结果自动恢复为 15.00/115.00/57.50"],
      "observable": { "type": "ui_state", "target": "自定义输入、比例按钮选中态、错误文本和结果" },
      "verification_layers": ["unit", "integration", "ui", "e2e"],
      "oracle": { "type": "state_table", "expected": { "0": "0.00|100.00|50.00", "100": "100.00|200.00|100.00", "invalid": ["-0.01", "100.01", "abc", ""], "presetRecovery": "15%|15.00|115.00|57.50" } },
      "environment": { "device_required": true, "capabilities": ["HarmonyOS ArkUI reactive state"] },
      "priority": "P0"
    },
    {
