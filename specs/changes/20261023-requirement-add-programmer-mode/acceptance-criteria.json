  "assumptions": [
    {
      "id": "AS-001",
      "decision": "支持范围采用无符号 64 位整数 0..2^64-1，不支持负数、补码或可选字长。",
      "rationale": "Issue 要求边界与超范围反馈但未指定符号模型；U64 是程序员转换器中安全、明确、可逆且不扩展到算术表达式的最小常规范围。"
    },
    {
      "id": "AS-002",
      "decision": "首次进入程序员模式采用 DEC 空输入，两模式仅在当前页面生命周期内分别保留状态。",
      "rationale": "十进制是最保守默认值；页面内隔离满足状态稳定要求，同时避免新增持久化 schema 和迁移。"
    },
    {
      "id": "AS-003",
      "decision": "切换输入进制时保持数值语义并规范化草稿；HEX 输出统一大写，不接受进制前缀。",
      "rationale": "这是常规转换器的可逆行为，可避免把相同文本重新解释为另一数值并收窄输入语法。"
    },
    {
      "id": "AS-004",
      "decision": "模式过渡采用 180ms ease-in-out、opacity 与 y=4vp 位移，动画不提交业务状态。",
      "rationale": "轻量、局部、可取消且不引入异步业务回调，满足流畅性并降低快速切换错态风险。"
    },
    {
      "id": "AS-005",
      "decision": "规划沿用仓库现有单 entry HAP、ArkUI V1 @State、无新增权限/网络/依赖/路由的实现边界。",
      "rationale": "符合现有代码约定，最小化权限与范围并保持普通计算器向后兼容。"
    }
  ],
  "out_of_scope": [
    "位运算与程序员算术表达式",
    "负数、补码、可选字长和浮点进制转换",
    "0x/0b/0o 前缀、数字分组和外部键盘专项适配",
    "程序员模式历史、跨应用重启持久化、复制或粘贴增强",
    "新增权限、网络服务、后台任务、第三方依赖或部署模块"
  ]
}
