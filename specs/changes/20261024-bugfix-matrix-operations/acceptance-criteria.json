  "assumptions": [
    {"id":"A-001","decision":"切换维度保留左上重叠输入，清结果和错误，新增单元格为空。","rationale":"避免不可逆数据丢失，同时消除错误维度派生状态。"},
    {"id":"A-002","decision":"数字语法仅接受可选符号的普通十进制，不接受指数、NaN、Infinity。","rationale":"严格匹配 Issue 明示的整数、负数和小数范围。"},
    {"id":"A-003","decision":"合法结果按 12 位有效数字消噪并将 -0 归一为 0。","rationale":"复用现有 DEFAULT_PREFERENCES.numberPrecision=12 的精度基线。"},
    {"id":"A-004","decision":"det(A) 只校验 A；B 可为空。","rationale":"B 不参与该运算，不应制造无关阻断。"},
    {"id":"A-005","decision":"矩阵状态仅会话内存在，不写历史或 Preferences。","rationale":"Issue 未要求持久化，最小化兼容性和数据影响。"},
    {"id":"A-006","decision":"矩阵使用与 PlotPanel 一致的全屏覆盖面板。","rationale":"遵循现有单页约定并隔离标量 UI 状态。"}
  ],
  "out_of_scope": ["矩阵求逆","矩阵转置","特征值","非方阵","混合维度运算","4×4 及以上矩阵","矩阵持久化或历史","导入导出","复杂数矩阵"]
}
