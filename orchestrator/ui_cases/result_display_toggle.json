{
  "version": 1,
  "suite": "result-display-toggle-regression",
  "cases": [
    {
      "id": "half-toggle",
      "purpose": "1 divided by 2 toggles between decimal and reduced fraction without changing the expression",
      "expression": "1÷2",
      "assertions": [
        {"type": "text_present", "values": ["0.5", "1/2", "1÷2"]},
        {"type": "screenshot_required"},
        {"type": "ui_tree_required"}
      ]
    },
    {
      "id": "third-toggle",
      "purpose": "1 divided by 3 renders as 1/3 and restores the decimal snapshot",
      "expression": "1÷3",
      "assertions": [
        {"type": "text_present", "values": ["1/3", "1÷3"]},
        {"type": "screenshot_required"},
        {"type": "ui_tree_required"}
      ]
    },
    {
      "id": "reduced-half",
      "purpose": "2 divided by 4 reduces to 1/2",
      "expression": "2÷4",
      "assertions": [
        {"type": "text_present", "values": ["1/2", "2÷4"]},
        {"type": "screenshot_required"},
        {"type": "ui_tree_required"}
      ]
    },
    {
      "id": "negative-half",
      "purpose": "Negative one divided by two renders as -1/2",
      "expression": "-1÷2",
      "assertions": [
        {"type": "text_present", "values": ["-1/2"]},
        {"type": "screenshot_required"},
        {"type": "ui_tree_required"}
      ]
    },
    {
      "id": "integer-fraction-mode",
      "purpose": "4 divided by 2 remains 2 without a /1 suffix",
      "expression": "4÷2",
      "assertions": [
        {"type": "text_present", "values": ["2"]},
        {"type": "text_absent", "values": ["2/1"]},
        {"type": "screenshot_required"},
        {"type": "ui_tree_required"}
      ]
    }
  ]
}
